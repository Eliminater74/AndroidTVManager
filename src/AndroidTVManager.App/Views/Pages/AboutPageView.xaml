<UserControl x:Class="AndroidTVManager.App.Views.Pages.AboutPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,26,34,28">
        <StackPanel>
            <TextBlock Text="ABOUT ANDROID TV MANAGER" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Text="{Binding ProductName}" FontSize="36" FontWeight="SemiBold"
                       Margin="0,7,0,0"/>
            <TextBlock Text="{Binding ProductDescription}" Foreground="{StaticResource TextSecondary}"
                       FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,34,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DEVELOPED BY" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding DeveloperName}" FontSize="24"
                                       FontWeight="SemiBold" Margin="0,7,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="VERSION" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding Version}" Foreground="{StaticResource CyanAccent}"
                                       FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding ReleaseChannel}" Foreground="{StaticResource VioletAccent}"
                                       FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Mission}" FontSize="18" TextWrapping="Wrap"
                               Margin="0,22,0,0"/>
                    <Border Background="{StaticResource ControlBackgroundBrush}" CornerRadius="8" Padding="14"
                            Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BUILD" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="{Binding Build}" Margin="0,5,0,0"/>
                                <TextBlock Text="PLATFORM" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,0"/>
                                <TextBlock Text="{Binding Platform}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text=".NET RUNTIME" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="{Binding RuntimeVersion}" Margin="0,5,0,0"/>
                                <TextBlock Text="DATABASE SCHEMA" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,0"/>
                                <TextBlock Text="{Binding DatabaseSchemaVersion}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Expander Header="TECHNICAL INFORMATION" IsExpanded="False" Margin="0,18,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="ADB / PLATFORM-TOOLS" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding PlatformToolsVersion}" Margin="0,5,0,0"/>
                            <TextBlock Text="MANAGED TOOLS LOCATION" Style="{StaticResource SectionLabelStyle}"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="{Binding ManagedToolsLocation}" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="INFORMATIONAL VERSION" Style="{StaticResource SectionLabelStyle}"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="{Binding InformationalVersion}" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="Copy app information" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding CopyAppInformationCommand}"/>
                        <TextBlock Text="{Binding CopyStatus}" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Android TV Manager  ·  Developed by Eliminater74"
                               Foreground="{StaticResource TextSecondary}" Margin="0,22,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
