<UserControl x:Class="AndroidTVManager.App.Views.Pages.DeploymentProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AndroidTVManager.App.ViewModels">
    <Grid Margin="34,26,34,28">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="DEPLOYMENT PROFILES" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource CyanAccent}"/>
                <TextBlock Text="Rebuild a device consistently after a reset" FontSize="34"
                           FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="Profiles install copied APK assets and run reviewed package or script steps sequentially."
                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PROFILES" Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center"/>
                                <Button Content="New" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding NewProfileCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                     DisplayMemberPath="Name" Margin="0,12,0,0" MinHeight="220"/>
                            <Button Content="Delete selected profile" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteProfileCommand}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="PROFILE NAME" Style="{StaticResource SectionLabelStyle}"/>
                                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0"/>
                                    <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,0"/>
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DEPLOY TARGET" Style="{StaticResource SectionLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                              DisplayMemberPath="FriendlyName" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding SelectedDevice.Serial, StringFormat=Serial: {0}}"
                                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0"/>
                                    <Border Background="{StaticResource SurfaceSecondaryBrush}"
                                            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="8" Margin="0,12,0,0">
                                        <TextBlock Text="{Binding Compatibility.State, StringFormat=Compatibility: {0}}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Add APKs / split archives" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding ImportPackagesCommand}"/>
                                <Button Content="Add folder" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding ImportFolderCommand}" Margin="8,0,0,0"/>
                                <Button Content="Save profile" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding SaveProfileCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding PendingPackages}" Margin="0,12,0,0"
                                     MaxHeight="130" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextSecondary}"
                                                   Margin="4,3"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="PROFILE STEPS" Style="{StaticResource SectionLabelStyle}" Margin="0,18,0,0"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                                         MinHeight="120" MaxHeight="220"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,3">
                                                <TextBlock Text="{Binding Kind}" Width="120"
                                                           Foreground="{StaticResource CyanAccent}"/>
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <Button Content="Move up" Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding MoveStepUpCommand}" Margin="0,0,0,5"/>
                                    <Button Content="Move down" Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding MoveStepDownCommand}" Margin="0,0,0,5"/>
                                    <Button Content="Remove" Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding RemoveStepCommand}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}"
                                         Width="250" ToolTip="com.example.package"/>
                                <Button Content="Add disable step" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding AddDisableStepCommand}" Margin="8,0,0,0"/>
                                <Button Content="Add enable step" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding AddEnableStepCommand}" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Deploy profile" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding DeployCommand}"/>
                                <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding CancelCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>

                            <TextBlock Text="RECENT EXECUTIONS" Style="{StaticResource SectionLabelStyle}" Margin="0,18,0,0"/>
                            <DataGrid ItemsSource="{Binding Executions}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" MinHeight="100"
                                      Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                    <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="*"/>
                                    <DataGridTextColumn Header="Started" Binding="{Binding StartedUtc}" Width="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
