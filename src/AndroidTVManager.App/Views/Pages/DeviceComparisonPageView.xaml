<UserControl x:Class="AndroidTVManager.App.Views.Pages.DeviceComparisonPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,26,34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="DEVICE COMPARISON" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Text="Compare hardware, builds, packages, and capabilities" FontSize="34"
                       FontWeight="SemiBold" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding LeftDevice}"
                          DisplayMemberPath="FriendlyName" Width="280"/>
                <TextBlock Text="against" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" Margin="10,0"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding RightDevice}"
                          DisplayMemberPath="FriendlyName" Width="280"/>
                <Button Content="Compare" Command="{Binding CompareCommand}"
                        Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Sections}" AutoGenerateColumns="False"
                  IsReadOnly="True" Margin="0,18,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Section" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Left device" Binding="{Binding LeftSummary}" Width="*"/>
                <DataGridTextColumn Header="Right device" Binding="{Binding RightSummary}" Width="*"/>
                <DataGridCheckBoxColumn Header="Changed" Binding="{Binding Changed}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
