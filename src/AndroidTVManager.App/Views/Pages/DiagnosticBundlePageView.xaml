<UserControl x:Class="AndroidTVManager.App.Views.Pages.DiagnosticBundlePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,26,34,28">
        <StackPanel>
            <TextBlock Text="DIAGNOSTIC BUNDLES" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Text="Collect evidence without running a wall of commands" FontSize="34"
                       FontWeight="SemiBold" Margin="0,5,0,0"/>
            <TextBlock Text="Bundles include device intelligence, configuration, display/HDMI, transport, packages, network, codecs, and a bounded logcat capture."
                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,26,0,0">
                <StackPanel>
                    <TextBlock Text="CAPTURE OPTIONS" Style="{StaticResource SectionLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="FriendlyName" Width="320" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Privacy:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                        <ComboBox ItemsSource="{Binding PrivacyModes}" SelectedItem="{Binding PrivacyMode}"
                                  Width="180" Margin="8,0,0,0"/>
                        <TextBlock Text="Logcat lines:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" Margin="18,0,8,0"/>
                        <TextBox Text="{Binding LogcatLineLimit, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    </StackPanel>
                    <TextBlock Text="Support Redacted removes serials, MAC addresses, IP addresses, SSIDs, and credential-like values. Local Full is intended to stay on this PC."
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Create diagnostic bundle" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding CreateCommand}"/>
                        <Button Content="Open output folder" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding OpenFolderCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
