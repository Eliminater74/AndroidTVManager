                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A344B"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#16273D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,18">
                    <Border Background="#121D30" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="●" FontSize="12" Foreground="{StaticResource GreenAccent}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AdbStatus}" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding AdbVersion}" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ConnectedDeviceCount, StringFormat={}{0} connected device(s)}"
                                       Foreground="{StaticResource CyanAccent}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Windows desktop toolbox" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Background="{StaticResource WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#182337" BorderThickness="0,0,0,1">
                <DockPanel Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNavigation.Label}" Foreground="{StaticResource TextPrimary}"
                                   FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedPageDescription}" Foreground="{StaticResource TextSecondary}"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TARGET" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="Serial" Width="185" Margin="0,0,10,0"/>
                        <Button Content="↻  Refresh" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentPage}"/>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#0A101B" Padding="28,0">
                <DockPanel>
                    <TextBlock Text="{Binding AdbStatus}" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FooterText}"
                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
