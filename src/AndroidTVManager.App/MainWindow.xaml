                                                       FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding ConnectionType}" Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Top" Text="SAVED DEVICES" Style="{StaticResource SectionLabelStyle}"
                               Margin="0,16,0,8"/>
                    <ListBox ItemsSource="{Binding SavedDevices}" SelectedItem="{Binding SelectedSavedDevice}"
                             Height="210">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="8"
                                        Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ReportedName, StringFormat=Device name: {0}}"
                                                       Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                            <TextBlock Text="{Binding Model, StringFormat=Model: {0}}"
                                                       Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding MacAddress, StringFormat=MAC: {0}}"
                                                       Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                            <TextBlock Text="{Binding LastKnownEndpoint, StringFormat=Endpoint: {0}}"
                                                       Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                            <TextBlock Text="{Binding LastSeenUtc, StringFormat=Last seen: {0:g}}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Reconnect" Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding DataContext.ReconnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="★" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Forget" Style="{StaticResource DangerButtonStyle}" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="SAVE SELECTED DEVICE" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FriendlyName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Save device" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding SaveDeviceCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding SaveMessage}" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,7,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SavedName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Friendly name for selected saved device"/>
                            <Button Grid.Column="1" Content="Rename" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RenameSavedCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SavedNotes, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Notes for selected saved device"/>
                            <Button Grid.Column="1" Content="Save notes" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding SaveNotesCommand}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="CONNECTIONS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Connect a device" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Traditional network ADB and modern Android Wireless Debugging pairing."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="NETWORK ADB" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBlock Text="Connect using an IP address or hostname" FontSize="18"
                                       FontWeight="SemiBold" Margin="0,6,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="Connect" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding ConnectCommand}"/>
                            </Grid>
                            <TextBlock Text="ANDROID WIRELESS DEBUGGING" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}" Margin="0,28,0,0"/>
                            <TextBlock Text="Pairing port and debugging port can be different." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,6,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding PairingPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="2" Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <Button Grid.Column="3" Content="Pair" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding PairCommand}"/>
                            </Grid>
                            <TextBlock Text="CONNECT AND SAVE PAIRED DEVICE" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}" Margin="0,16,0,0"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DebugPort, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Debugging port shown beside Wireless Debugging"
                                         Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding FriendlyName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Friendly name, for example Bedroom TV"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="Pair, connect &amp; save"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding PairConnectAndSaveCommand}"/>
                            </Grid>
                            <Border Background="{StaticResource ControlBackgroundBrush}" CornerRadius="7" Padding="12" Margin="0,18,0,0">
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,24,0,0">
                        <TextBlock Text="RECENT SESSIONS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Refresh history"
                                Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshHistoryCommand}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding History}" Style="{StaticResource DataGridModernStyle}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column" IsReadOnly="True" Height="190"
                              Margin="0,10,0,0" Background="{StaticResource PanelBackground}"
                              Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding FriendlyName}" Width="*"/>
                            <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="*"/>
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*"/>
                            <DataGridTextColumn Header="State" Binding="{Binding CurrentState}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallApkPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="INSTALL APK" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Install an app" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Push a signed APK to the selected Android TV device with a safe, visible command."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="INSTALLATION TARGET" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBox Text="{Binding TargetSerial, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,10,0,18"/>
                            <Border Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="APK INSTALLATION METHOD: ADB" FontWeight="Bold"
                                               Foreground="{StaticResource GreenAccent}"/>
                                    <TextBlock Text="{Binding InstallationInfo}" Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <Button Content="Learn more" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Left" Command="{Binding ShowVerificationGuideCommand}"
                                            Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="APK FILE PATH" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <Grid Margin="0,10,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ApkPath, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding BrowseApkCommand}"/>
                            </Grid>
                            <Button Content="Install with reinstall" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding InstallCommand}"/>
                            <Border Background="{StaticResource ControlBackgroundBrush}" CornerRadius="7" Padding="12" Margin="0,18,0,0">
                                <TextBlock Text="{Binding Output}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="APPLICATIONS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Installed packages" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Inspect and manage packages on one explicitly selected device."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox Content="Show package icons"
                                  IsChecked="{Binding ShowPackageIcons}"
                                  VerticalAlignment="Center"/>
                        <Border Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource AmberAccent}" BorderThickness="1"
                                CornerRadius="6" Padding="9,5" Margin="14,0,0,0">
                            <TextBlock Text="Optional: icons may add load time and ADB traffic after scanning."
                                       Foreground="{StaticResource AmberAccent}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding IconStatus}" Foreground="{StaticResource TextMuted}"
                               FontSize="11" Margin="2,6,0,0"/>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TargetSerial, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                                  Width="125" Margin="0,0,10,0"/>
                        <Button Grid.Column="3" Content="Refresh packages" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RefreshCommand}"/>
                    </Grid>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <ListBox ItemsSource="{Binding FilteredPackages}" SelectedItem="{Binding SelectedPackage}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="6"
                                                Background="{StaticResource SurfaceSecondaryBrush}">
                                            <Grid>
                                                <TextBlock Text="▦" FontSize="17"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding IconPath}" Width="28" Height="28"
                                                       Stretch="Uniform"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding PackageName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding IsSystem, StringFormat=System package: {0}}"
                                                       Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="PACKAGE ACTIONS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}"/>
                        <Button Content="Launch" Style="{StaticResource GhostButtonStyle}" Margin="0,12,0,4"
                                Command="{Binding LaunchCommand}"/>
                        <Button Content="Force stop" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding ForceStopCommand}"/>
                        <Button Content="Disable" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding DisableCommand}"/>
                        <Button Content="Enable" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding EnableCommand}"/>
                        <Button Content="Uninstall for user 0" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding UninstallCommand}"/>
                        <Button Content="Restore package" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding RestoreCommand}"/>
                        <Button Content="Clear data" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding ClearDataCommand}"/>
                        <Button Content="Clear cache" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding ClearCacheCommand}"/>
                        <Button Content="View package details" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding ViewDetailsCommand}"/>
                        <Button Content="Open app settings" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding OpenAppSettingsCommand}"/>
                        <Button Content="Full uninstall" Style="{StaticResource DangerButtonStyle}" Margin="0,4"
                                Command="{Binding FullUninstallCommand}"/>
                        <TextBlock Text="PERMISSION" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding Permission, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="android.permission.*"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Grant" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding GrantPermissionCommand}"/>
                            <Button Content="Revoke" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RevokePermissionCommand}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="PACKAGE PREFERENCE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding OverrideOptions}" SelectedItem="{Binding SelectedOverride}"/>
                        <Button Content="Save preference" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding SaveOverrideCommand}" Margin="0,6,0,0"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42"
                                 ToolTip="Optional package note" Margin="0,6,0,0"/>
                        <Button Content="Save note" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding SaveNoteCommand}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="TOOLS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Device utilities" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Powerful commands stay visible, targeted, and cancellable."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="TARGET SERIAL" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      ItemTemplate="{StaticResource DeviceSelectorTemplate}" Margin="0,10,0,6"/>
                            <TextBox Text="{Binding TargetSerial, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,18"/>
                            <TextBlock Text="ADB SHELL" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <Grid Margin="0,10,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ShellCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Run shell" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding RunShellCommand}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                          Width="190" ToolTip="Safe command preset"/>
                                <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding CancelShellCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Screenshot" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding ScreenshotCommand}" Margin="0,0,8,0"/>
                                <Button Content="Reboot" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding RebootCommand}"/>
                            </StackPanel>
                            <Border Background="{StaticResource ControlBackgroundBrush}" CornerRadius="7" Padding="12" Margin="0,18,0,0">
                                <TextBlock Text="{Binding Output}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="RECENT COMMANDS" Style="{StaticResource SectionLabelStyle}" Margin="0,18,0,8"/>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Command}" Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScriptsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="SCRIPTS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Safe automation" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Structured .atmscript JSON with validation and a human-readable preview."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Validate and preview" Style="{StaticResource AccentButtonStyle}"
                                    Margin="0,14,0,0" Command="{Binding ValidateScriptCommand}"/>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock Text="TARGET DEVICE" Style="{StaticResource SectionLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                          ItemTemplate="{StaticResource DeviceSelectorTemplate}" Margin="0,8,0,6"/>
                                <TextBox Text="{Binding TargetSerial, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter a serial when the device is not listed."/>
                            </StackPanel>
                            <TextBox Text="{Binding ScriptJson, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="12"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelRaisedBackground}"
                            CornerRadius="12" Padding="20" Margin="10,0,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Run script" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding RunScriptCommand}" Margin="0,0,8,0"/>
                                <Button Content="Undo last run" Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding UndoLastCommand}"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="Live application log" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Monitor Android TV Manager activity without opening a separate editor."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,24,0,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Refresh" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
                            <Button Content="Clear log" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding LogPath}" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12"
                        Height="520" VerticalAlignment="Top">
                    <ListBox ItemsSource="{Binding Entries}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             FontFamily="Consolas" FontSize="12"/>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Tune your workspace" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Runtime data stays in LocalAppData so Program Files installs remain clean."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="GENERAL" Style="{StaticResource SectionLabelStyle}"/>
                            <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                            <CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0"/>
                            <CheckBox Content="Close to tray" IsChecked="{Binding CloseToTray}"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0"/>
                            <CheckBox Content="Remember last selected device" IsChecked="{Binding RememberSelectedDevice}"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0"/>
                            <TextBlock Text="THEME" Style="{StaticResource SectionLabelStyle}" Margin="0,18,0,0"/>
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                      Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="ADB RUNTIME" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBlock Text="Official Google Platform-Tools" FontSize="19" FontWeight="SemiBold"
                                       Margin="0,6,0,16"/>
                            <Button Content="Repair / reinstall Platform-Tools" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding RepairPlatformToolsCommand}"/>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,12,0,18" TextWrapping="Wrap"/>
                            <TextBlock Text="DATA LOCATIONS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBlock Text="{Binding DataPath}" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Open data" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0"/>
                                <Button Content="Open tools" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding OpenToolsFolderCommand}" Margin="0,0,8,0"/>
                                <Button Content="Open logs" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding OpenLogsFolderCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Eyebrow}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}"
                               FontSize="14" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,28,0,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="LIVE WORKSPACE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBlock Text="No Android TV devices connected yet" FontSize="20"
                                       FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock Text="Enable ADB on your TV, then connect it to see live diagnostics here."
                                       Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="Refresh devices" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </DockPanel>
                </Border>
                <UniformGrid Grid.Row="2" Columns="3" Rows="2">
                    <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="10"
                            Margin="0,0,12,12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="CONNECTED DEVICES" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DataContext.ConnectedDeviceCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="30" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"
                                       Margin="0,9,0,0"/>
                            <TextBlock Text="Live ADB targets" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="10"
                            Margin="0,0,12,12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Connect · Pair · Install" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,13,0,0"/>
                            <TextBlock Text="Everything is ready when your device is." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="10"
                            Margin="0,0,0,12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="ADB RUNTIME" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DataContext.AdbStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AmberAccent}"
                                       Margin="0,13,0,0"/>
                            <TextBlock Text="{Binding DataContext.AdbVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBackground}" CornerRadius="10"
                            Margin="0,0,12,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="RECENT ACTIVITY" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Nothing recorded yet" Margin="0,13,0,0" FontSize="16"/>
                            <TextBlock Text="Connection history will appear here." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBackground}" CornerRadius="10"
                            Margin="0,0,12,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="SAFETY FIRST" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Captured targets" Margin="0,13,0,0" FontSize="16"/>
                            <TextBlock Text="Operations keep the selected device locked in." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBackground}" CornerRadius="10"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.BetaLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DataContext.Version, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Margin="0,13,0,0" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{StaticResource GreenAccent}"/>
                            <TextBlock Text="Modern ADB, built for the living room." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBackground}" Grid.Column="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource SurfaceElevatedBrush}">
                            <TextBlock Text="✦" Foreground="{StaticResource CyanAccent}" FontSize="25"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ANDROID TV" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="MANAGER" FontSize="17" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding BetaLabel}" Foreground="{StaticResource VioletAccent}"
                               FontSize="10" FontWeight="Bold" Margin="54,6,0,0"/>
                </StackPanel>
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="MAIN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                   Margin="24,0,0,6"/>
                        <ListBox ItemsSource="{Binding MainNavigation}" SelectedItem="{Binding SelectedNavigation}"
                                 Margin="0,5,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Width="26" FontSize="17"
                                           Foreground="{StaticResource CyanAccent}"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="PREFERENCES" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondary}" Margin="24,20,0,6"/>
                        <ListBox ItemsSource="{Binding SecondaryNavigation}" SelectedItem="{Binding SelectedNavigation}"
                                 Margin="0,0,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Width="26" FontSize="17"
                                           Foreground="{StaticResource VioletAccent}"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,18">
                    <Border Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="●" FontSize="12" Foreground="{StaticResource GreenAccent}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AdbStatus}" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding AdbVersion}" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ConnectedDeviceCount, StringFormat={}{0} connected device(s)}"
                                       Foreground="{StaticResource CyanAccent}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Windows desktop toolbox" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Background="{StaticResource WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNavigation.Label}" Foreground="{StaticResource TextPrimary}"
                                   FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedPageDescription}" Foreground="{StaticResource TextSecondary}"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TARGET" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                  ItemTemplate="{StaticResource DeviceSelectorTemplate}" Width="185" Margin="0,0,10,0"/>
                        <Button Content="↻  Refresh" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer x:Name="PageScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <ContentControl Content="{Binding CurrentPage}"/>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{StaticResource ControlBackgroundBrush}" Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AdbStatus}" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectedDeviceCount, StringFormat={}{0} connected device(s)}"
                                   Foreground="{StaticResource CyanAccent}" Margin="18,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding FooterText}"
                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
