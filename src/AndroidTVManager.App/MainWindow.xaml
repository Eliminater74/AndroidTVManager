<Window x:Class="AndroidTVManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AndroidTVManager.App.ViewModels"
        Title="Android TV Manager"
        Width="1240"
        Height="780"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        Loaded="Window_Loaded"
        >
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="DASHBOARD" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource CyanAccent}"/>
                        <TextBlock Text="Welcome back" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="Your Android TV and Google TV devices, at a glance."
                                   Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="＋  Connect device"
                            Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Connections"/>
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,26,0,0">
                    <Border Background="{StaticResource PanelRaisedBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="11" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="CONNECTED DEVICES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding DataContext.ConnectedDeviceCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="30" FontWeight="Bold" Foreground="{StaticResource GreenAccent}"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Live ADB targets" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelRaisedBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="11" Padding="18" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="PLATFORM TOOLS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding DataContext.AdbStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"
                                       Margin="0,11,0,0"/>
                            <TextBlock Text="{Binding DataContext.AdbVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelRaisedBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="11" Padding="18" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="WORKFLOW" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="Ready when you are" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource VioletAccent}" Margin="0,11,0,0"/>
                            <TextBlock Text="Connect, inspect, install, automate" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <StackPanel Grid.Row="2" Margin="0,26,0,0">
                    <TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource VioletAccent}"/>
                    <UniformGrid Columns="6" Margin="0,10,0,0">
                        <Button Content="＋  Connect" Style="{StaticResource GhostButtonStyle}" Margin="0,0,7,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Connections"/>
                        <Button Content="⌁  Pair" Style="{StaticResource GhostButtonStyle}" Margin="3,0,4,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Connections"/>
                        <Button Content="↓  Install APK" Style="{StaticResource GhostButtonStyle}" Margin="4,0,3,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Install APK"/>
                        <Button Content="▦  Applications" Style="{StaticResource GhostButtonStyle}" Margin="4,0,3,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Applications"/>
                        <Button Content="⌁  Screenshot" Style="{StaticResource GhostButtonStyle}" Margin="4,0,3,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Tools"/>
                        <Button Content="&gt;_  ADB Shell" Style="{StaticResource GhostButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Tools"/>
                    </UniformGrid>
                </StackPanel>
                <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,24,0,0">
                    <Grid>
                        <StackPanel>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="CONNECTED DEVICES" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource VioletAccent}"/>
                                    <TextBlock Text="Live targets and current state" Foreground="{StaticResource TextSecondary}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="View all →" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="Devices"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Devices}" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="8"
                                                Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▣" FontSize="22" Foreground="{StaticResource CyanAccent}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Model}" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Serial}" Foreground="{StaticResource TextSecondary}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding State}" Foreground="{StaticResource GreenAccent}"
                                                               FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding ConnectionType}" Foreground="{StaticResource TextSecondary}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Background="#0A101B" CornerRadius="10" Padding="28"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDevices}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="◉" FontSize="38" Foreground="{StaticResource CyanAccent}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="No Android devices connected" FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="Connect over your network, pair with Wireless Debugging,&#10;or attach a USB device to get started."
                                           Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                           HorizontalAlignment="Center" Margin="0,8,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Connect Device" Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Connections" Margin="0,0,8,0"/>
                                    <Button Content="Pair Wireless" Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Connections"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceStatusPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="DEVICE STATUS" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="Device intelligence" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Inspect what Android exposes, with evidence for every important capability."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,24,0,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Inspect device" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding InspectCommand}" Margin="8,0,0,0"/>
                            <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding CancelInspectionCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="TARGET DEVICE" Style="{StaticResource SectionLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="Serial" Width="280" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="OVERVIEW" Style="{StaticResource SectionLabelStyle}"/>
                                <UniformGrid Columns="4" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MODEL" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Overview.Value.Model}" FontWeight="SemiBold" Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ANDROID" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Overview.Value.AndroidVersion}" FontWeight="SemiBold" Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="API LEVEL" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Overview.Value.ApiLevel}" FontWeight="SemiBold" Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="SERIAL" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Serial}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding Inspection.Overview.Value.BuildFingerprint}"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                        <Expander Header="WHAT THIS DEVICE CAN DO" IsExpanded="True" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding Inspection.Capabilities}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{StaticResource CyanAccent}"
                                                           FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Expander Header="HARDWARE AND PERFORMANCE" IsExpanded="True" Margin="0,0,7,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Cpu.Value.Architecture, StringFormat=Architecture: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Cpu.Value.LogicalCoreCount, StringFormat=Logical cores: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Memory.Value.TotalBytes, StringFormat=RAM bytes: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Display.Value.CurrentResolution, StringFormat=Display: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Storage.Value.Volumes.Count, StringFormat=Storage volumes: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="SECURITY AND INSTALLATION" IsExpanded="True" Margin="7,0,0,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Security.Value.SelinuxState, StringFormat=SELinux: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Security.Value.VerifiedBootState, StringFormat=Verified Boot: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Security.Value.AdbRoot, StringFormat=ADB root: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.DeveloperVerification.Value.VerifierPresent, StringFormat=Developer Verifier: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="ADB installation: Supported; manual verification state: Check on device."
                                               Foreground="{StaticResource GreenAccent}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Expander>
                        </UniformGrid>
                        <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="10"
                                Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="ANDROID APP INSTALLATION" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="ADB installation is supported and is not subject to Android's manual unverified-developer waiting period."
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding GuideText}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Button Content="Unverified App Installation Guide" Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Left" Command="{Binding ShowUnverifiedInstallGuideCommand}"
                                        Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebloatPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="DEBLOAT" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="Guided package cleanup" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Preview every device-specific change. Unknown and critical packages stay protected."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,24,0,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Create preview" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding CreatePlanCommand}" Margin="8,0,0,0"/>
                            <Button Content="Run selected" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding ExecutePlanCommand}" Margin="8,0,0,0"/>
                            <Button Content="Restore last" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RestoreLastCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="TARGET DEVICE" Style="{StaticResource SectionLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="Serial" Width="250" Margin="0,8,16,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="PRESET" Style="{StaticResource SectionLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                          Width="140" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Plan.Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#332B14" CornerRadius="7" Padding="10" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource AmberAccent}" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="PLAN ITEMS" Style="{StaticResource SectionLabelStyle}"/>
                                <ItemsControl ItemsSource="{Binding Plan.Items}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="8"
                                                    Padding="12" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="250"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Package.PackageName}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Assessment.Risk}"
                                                               Foreground="{StaticResource AmberAccent}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SelectionBlockReason}"
                                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="ABOUT" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Android TV Manager" FontSize="36" FontWeight="SemiBold"
                               Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding ProductLine}" Foreground="{StaticResource TextSecondary}"
                               FontSize="15" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,34,0,0">
                        <StackPanel>
                            <TextBlock Text="BETA 1" Foreground="{StaticResource VioletAccent}"
                                       FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="{Binding Version}" Foreground="{StaticResource CyanAccent}"
                                       FontSize="32" FontWeight="Bold" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding Mission}" FontSize="18" TextWrapping="Wrap"
                                       Margin="0,16,0,0"/>
                            <Border Background="#0A101B" CornerRadius="8" Padding="14"
                                    Margin="0,22,0,0">
                                <TextBlock Text="{Binding PlatformToolsNote}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Built with C# · .NET 10 · WPF · SQLite"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,22,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="DEVICES" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Your devices" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Live state from the ADB tracker. Offline and unauthorized devices remain visible."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="12" Margin="0,28,0,0">
                    <DockPanel>
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,14" Margin="0,0,0,8" Background="{StaticResource PanelRaisedBackground}"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Model}" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Serial}" Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding State}" Foreground="{StaticResource GreenAccent}"
                                                       FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding ConnectionType}" Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="SAVE SELECTED DEVICE" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FriendlyName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Save device" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding SaveDeviceCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding SaveMessage}" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="CONNECTIONS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Connect a device" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Traditional network ADB and modern Android Wireless Debugging pairing."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="NETWORK ADB" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBlock Text="Connect using an IP address or hostname" FontSize="18"
                                       FontWeight="SemiBold" Margin="0,6,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="Connect" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding ConnectCommand}"/>
                            </Grid>
                            <TextBlock Text="ANDROID WIRELESS DEBUGGING" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}" Margin="0,28,0,0"/>
                            <TextBlock Text="Pairing port and debugging port can be different." Foreground="{StaticResource TextSecondary}"
