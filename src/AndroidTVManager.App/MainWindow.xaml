<Window x:Class="AndroidTVManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AndroidTVManager.App.ViewModels"
        Title="Android TV Manager"
        Width="1240"
        Height="780"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ViewModel}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AboutPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="ABOUT" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Android TV Manager" FontSize="36" FontWeight="SemiBold"
                               Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding ProductLine}" Foreground="{StaticResource TextSecondary}"
                               FontSize="15" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,34,0,0">
                        <StackPanel>
                            <TextBlock Text="BETA 1" Foreground="{StaticResource VioletAccent}"
                                       FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="{Binding Version}" Foreground="{StaticResource CyanAccent}"
                                       FontSize="32" FontWeight="Bold" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding Mission}" FontSize="18" TextWrapping="Wrap"
                                       Margin="0,16,0,0"/>
                            <Border Background="#0A101B" CornerRadius="8" Padding="14"
                                    Margin="0,22,0,0">
                                <TextBlock Text="{Binding PlatformToolsNote}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Built with C# · .NET 10 · WPF · SQLite"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,22,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="DEVICES" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Your devices" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Live state from the ADB tracker. Offline and unauthorized devices remain visible."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="12" Margin="0,28,0,0">
                    <DockPanel>
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,14" Margin="0,0,0,8" Background="{StaticResource PanelRaisedBackground}"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Model}" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Serial}" Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding State}" Foreground="{StaticResource GreenAccent}"
                                                       FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding ConnectionType}" Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="SAVE SELECTED DEVICE" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FriendlyName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Save device" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding SaveDeviceCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding SaveMessage}" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="CONNECTIONS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Connect a device" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Traditional network ADB and modern Android Wireless Debugging pairing."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="NETWORK ADB" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBlock Text="Connect using an IP address or hostname" FontSize="18"
                                       FontWeight="SemiBold" Margin="0,6,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="Connect" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding ConnectCommand}"/>
                            </Grid>
                            <TextBlock Text="ANDROID WIRELESS DEBUGGING" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}" Margin="0,28,0,0"/>
                            <TextBlock Text="Pairing port and debugging port can be different." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,6,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding PairingPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="2" Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <Button Grid.Column="3" Content="Pair" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding PairCommand}"/>
                            </Grid>
                            <Border Background="#0A101B" CornerRadius="7" Padding="12" Margin="0,18,0,0">
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,24,0,0">
                        <TextBlock Text="RECENT SESSIONS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Refresh history"
                                Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshHistoryCommand}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" IsReadOnly="True" Height="190"
                              Margin="0,10,0,0" Background="{StaticResource PanelBackground}"
                              Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding FriendlyName}" Width="*"/>
                            <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="*"/>
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*"/>
                            <DataGridTextColumn Header="State" Binding="{Binding CurrentState}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallApkPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="INSTALL APK" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Install an app" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Push a signed APK to the selected Android TV device with a safe, visible command."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="INSTALLATION TARGET" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBox Text="{Binding TargetSerial, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,10,0,18"/>
                            <TextBlock Text="APK FILE PATH" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <Grid Margin="0,10,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ApkPath, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding BrowseApkCommand}"/>
                            </Grid>
                            <Button Content="Install with reinstall" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding InstallCommand}"/>
                            <Border Background="#0A101B" CornerRadius="7" Padding="12" Margin="0,18,0,0">
                                <TextBlock Text="{Binding Output}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="APPLICATIONS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Installed packages" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Inspect and manage packages on one explicitly selected device."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TargetSerial, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="Refresh packages" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RefreshCommand}"/>
                    </Grid>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <ListBox ItemsSource="{Binding FilteredPackages}" SelectedItem="{Binding SelectedPackage}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,7">
                                        <TextBlock Text="{Binding PackageName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding IsSystem, StringFormat=System package: {0}}"
                                                   Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="PACKAGE ACTIONS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}"/>
                        <Button Content="Launch" Style="{StaticResource GhostButtonStyle}" Margin="0,12,0,4"
                                Command="{Binding LaunchCommand}"/>
                        <Button Content="Force stop" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding ForceStopCommand}"/>
                        <Button Content="Disable" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding DisableCommand}"/>
                        <Button Content="Enable" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding EnableCommand}"/>
                        <Button Content="Uninstall for user 0" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding UninstallCommand}"/>
                        <Button Content="Clear data" Style="{StaticResource GhostButtonStyle}" Margin="0,4"
                                Command="{Binding ClearDataCommand}"/>
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="TOOLS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Device utilities" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Powerful commands stay visible, targeted, and cancellable."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="TARGET SERIAL" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBox Text="{Binding TargetSerial, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,18"/>
                            <TextBlock Text="ADB SHELL" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <Grid Margin="0,10,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ShellCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Run shell" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding RunShellCommand}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Screenshot" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding ScreenshotCommand}" Margin="0,0,8,0"/>
                                <Button Content="Reboot" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding RebootCommand}"/>
                            </StackPanel>
                            <Border Background="#0A101B" CornerRadius="7" Padding="12" Margin="0,18,0,0">
                                <TextBlock Text="{Binding Output}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScriptsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="SCRIPTS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Safe automation" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Structured .atmscript JSON with validation and a human-readable preview."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Validate and preview" Style="{StaticResource AccentButtonStyle}"
                                    Margin="0,14,0,0" Command="{Binding ValidateScriptCommand}"/>
                            <TextBox Text="{Binding ScriptJson, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="12"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelRaisedBackground}"
                            CornerRadius="12" Padding="20" Margin="10,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <Grid Margin="34,26,34,28">
                <StackPanel>
                    <TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Tune your workspace" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Runtime data stays in LocalAppData so Program Files installs remain clean."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="ADB RUNTIME" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBlock Text="Official Google Platform-Tools" FontSize="19" FontWeight="SemiBold"
                                       Margin="0,6,0,16"/>
                            <Button Content="Repair / reinstall Platform-Tools" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding RepairPlatformToolsCommand}"/>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,12,0,18" TextWrapping="Wrap"/>
                            <TextBlock Text="DATA LOCATIONS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBlock Text="{Binding DataPath}" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Open data" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0"/>
                                <Button Content="Open tools" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding OpenToolsFolderCommand}" Margin="0,0,8,0"/>
                                <Button Content="Open logs" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding OpenLogsFolderCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Eyebrow}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}"
                               FontSize="14" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,28,0,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="LIVE WORKSPACE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource VioletAccent}"/>
                            <TextBlock Text="No Android TV devices connected yet" FontSize="20"
                                       FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock Text="Enable ADB on your TV, then connect it to see live diagnostics here."
                                       Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="Refresh devices" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </DockPanel>
                </Border>
                <UniformGrid Grid.Row="2" Columns="3" Rows="2">
                    <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="10"
                            Margin="0,0,12,12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="CONNECTED DEVICES" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DataContext.ConnectedDeviceCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="30" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"
                                       Margin="0,9,0,0"/>
                            <TextBlock Text="Live ADB targets" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="10"
                            Margin="0,0,12,12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Connect · Pair · Install" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,13,0,0"/>
                            <TextBlock Text="Everything is ready when your device is." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="10"
                            Margin="0,0,0,12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="ADB RUNTIME" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DataContext.AdbStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AmberAccent}"
                                       Margin="0,13,0,0"/>
                            <TextBlock Text="{Binding DataContext.AdbVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBackground}" CornerRadius="10"
                            Margin="0,0,12,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="RECENT ACTIVITY" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Nothing recorded yet" Margin="0,13,0,0" FontSize="16"/>
                            <TextBlock Text="Connection history will appear here." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBackground}" CornerRadius="10"
                            Margin="0,0,12,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="SAFETY FIRST" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Captured targets" Margin="0,13,0,0" FontSize="16"/>
                            <TextBlock Text="Operations keep the selected device locked in." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBackground}" CornerRadius="10"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="BETA 1" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="1.0.0-B1" Margin="0,13,0,0" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{StaticResource GreenAccent}"/>
                            <TextBlock Text="Modern ADB, built for the living room." Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBackground}" Grid.Column="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#172F4E">
                            <TextBlock Text="✦" Foreground="{StaticResource CyanAccent}" FontSize="25"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ANDROID TV" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="MANAGER" FontSize="17" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="BETA 1  ·  1.0.0-B1" Foreground="{StaticResource VioletAccent}"
                               FontSize="10" FontWeight="Bold" Margin="54,6,0,0"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation}"
                         Margin="0,5,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Width="26" FontSize="17"
                                           Foreground="{StaticResource CyanAccent}"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A344B"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#16273D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,18">
                    <Border Background="#121D30" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ADB STATUS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding AdbStatus}" Foreground="{StaticResource AmberAccent}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Windows desktop toolbox" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Background="{StaticResource WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#182337" BorderThickness="0,0,0,1">
                <DockPanel Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="WORKSPACE" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="  /  " Foreground="{StaticResource PanelBorder}" Margin="8,0"/>
                        <TextBlock Text="{Binding SelectedNavigation.Label}" Foreground="{StaticResource TextPrimary}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentPage}"/>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#0A101B" Padding="28,0">
                <DockPanel>
                    <TextBlock Text="{Binding AdbStatus}" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="Android TV Manager  ·  1.0.0-B1"
                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
