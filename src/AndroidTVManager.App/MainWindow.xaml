<Window x:Class="AndroidTVManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AndroidTVManager.App.ViewModels"
        Title="Android TV Manager"
        Icon="Assets/AndroidTVManager.ico"
        Width="1240"
        Height="780"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        Loaded="Window_Loaded"
        >
    <Window.Resources>
        <DataTemplate x:Key="DeviceSelectorTemplate">
            <StackPanel>
                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Serial}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="DASHBOARD" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource CyanAccent}"/>
                        <TextBlock Text="Welcome back" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="Your Android TV and Google TV devices, at a glance."
                                   Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="＋  Connect device"
                            Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Connections"/>
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,26,0,0">
                    <Border Background="{StaticResource PanelRaisedBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="11" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="CONNECTED DEVICES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding DataContext.ConnectedDeviceCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="30" FontWeight="Bold" Foreground="{StaticResource GreenAccent}"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Live ADB targets" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelRaisedBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="11" Padding="18" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="PLATFORM TOOLS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding DataContext.AdbStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"
                                       Margin="0,11,0,0"/>
                            <TextBlock Text="{Binding DataContext.AdbVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelRaisedBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="11" Padding="18" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="WORKFLOW" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="Ready when you are" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource VioletAccent}" Margin="0,11,0,0"/>
                            <TextBlock Text="Connect, inspect, install, automate" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <StackPanel Grid.Row="2" Margin="0,26,0,0">
                    <TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource VioletAccent}"/>
                    <UniformGrid Columns="6" Margin="0,10,0,0">
                        <Button Content="＋  Connect" Style="{StaticResource GhostButtonStyle}" Margin="0,0,7,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Connections"/>
                        <Button Content="⌁  Pair" Style="{StaticResource GhostButtonStyle}" Margin="3,0,4,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Connections"/>
                        <Button Content="↓  Install APK" Style="{StaticResource GhostButtonStyle}" Margin="4,0,3,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Install APK"/>
                        <Button Content="▦  Applications" Style="{StaticResource GhostButtonStyle}" Margin="4,0,3,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Applications"/>
                        <Button Content="⌁  Screenshot" Style="{StaticResource GhostButtonStyle}" Margin="4,0,3,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Tools"/>
                        <Button Content="&gt;_  ADB Shell" Style="{StaticResource GhostButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Tools"/>
                    </UniformGrid>
                </StackPanel>
                <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,24,0,0">
                    <Grid>
                        <StackPanel>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="CONNECTED DEVICES" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource VioletAccent}"/>
                                    <TextBlock Text="Live targets and current state" Foreground="{StaticResource TextSecondary}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="View all →" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="Devices"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Devices}" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="8"
                                                Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▣" FontSize="22" Foreground="{StaticResource CyanAccent}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Model}" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Serial}" Foreground="{StaticResource TextSecondary}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding State}" Foreground="{StaticResource GreenAccent}"
                                                               FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding ConnectionType}" Foreground="{StaticResource TextSecondary}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="SAVED DEVICES" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,0"/>
                            <ItemsControl ItemsSource="{Binding SavedDevices}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Model}" Foreground="{StaticResource TextSecondary}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="○ OFFLINE" Foreground="{StaticResource TextMuted}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Background="{StaticResource ControlBackgroundBrush}" CornerRadius="10" Padding="28"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnyDevices}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="◉" FontSize="38" Foreground="{StaticResource CyanAccent}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="No Android devices connected" FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="Connect over your network, pair with Wireless Debugging,&#10;or attach a USB device to get started."
                                           Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                           HorizontalAlignment="Center" Margin="0,8,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Connect Device" Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Connections" Margin="0,0,8,0"/>
                                    <Button Content="Pair Wireless" Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Connections"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceStatusPageViewModel}">
            <Grid Margin="34,26,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="DEVICE STATUS" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="Device intelligence" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Inspect what Android exposes, with evidence for every important capability."
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,24,0,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Inspect device" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding InspectCommand}" Margin="8,0,0,0"/>
                            <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding CancelInspectionCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="TARGET DEVICE" Style="{StaticResource SectionLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      ItemTemplate="{StaticResource DeviceSelectorTemplate}" Width="280" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Row="2">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="OVERVIEW" Style="{StaticResource SectionLabelStyle}"/>
                                <UniformGrid Columns="4" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MODEL" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Overview.Value.Model}" FontWeight="SemiBold" Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ANDROID" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Overview.Value.AndroidVersion}" FontWeight="SemiBold" Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="API LEVEL" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Overview.Value.ApiLevel}" FontWeight="SemiBold" Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="SERIAL" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Serial}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DEVICE NAME REPORTED BY ANDROID"
                                                   Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Overview.Value.ReportedName, TargetNullValue=Not reported}"
                                                   FontWeight="SemiBold" Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MAC ADDRESS"
                                                   Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                        <TextBlock Text="{Binding Inspection.Overview.Value.MacAddress, TargetNullValue=Not reported}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Inspection.Overview.Value.BuildFingerprint}"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                        <Expander Header="WHAT THIS DEVICE CAN DO" IsExpanded="True" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding Inspection.Capabilities}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{StaticResource CyanAccent}"
                                                           FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Evidence[0].Confidence}"
                                                           Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Expander Header="PACKAGES" IsExpanded="True" Margin="0,0,7,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Packages.Value.TotalPackages, StringFormat=Visible packages: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Packages.State, StringFormat=Scan state: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Packages.Value.InstalledCount, StringFormat=Installed: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Packages.Value.DisabledCount, StringFormat=Disabled: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Packages.Value.EnabledCount, StringFormat=Enabled: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Packages.Value.UninstalledForUserCount, StringFormat=Uninstalled for user: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Packages.Value.UserPackageCount, StringFormat=User packages: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Packages.Value.SystemPackageCount, StringFormat=System packages: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Packages.Value.ActiveLauncherCount, StringFormat=Active launcher packages: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Packages.Value.AccessibilityServiceCount, StringFormat=Accessibility services: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Packages.Value.DeviceOwnerCount, StringFormat=Device owners: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <ListBox ItemsSource="{Binding Inspection.Packages.Value.PackageNames}"
                                             Height="230" Margin="0,10,0,0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="SERVICES" IsExpanded="False" Margin="7,0,0,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Services.Value.RunningServiceCount, StringFormat=Running services: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Services.State, StringFormat=Scan state: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <ListBox ItemsSource="{Binding Inspection.Services.Value.Entries}" Height="180"
                                             Margin="0,10,0,0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                    <TextBlock Text="{Binding PackageName}" Foreground="{StaticResource TextSecondary}"
                                                               FontSize="10"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Expander Header="OEM UNLOCK AND BOOTLOADER" IsExpanded="True" Margin="0,0,7,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.OemUnlock.Value.Option, StringFormat=OEM unlock option: {0}}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Inspection.OemUnlock.Value.Setting, StringFormat=OEM unlock setting: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.OemUnlock.Value.ActualUnlockCapability, StringFormat=Actual unlock capability: {0}}"
                                               Foreground="{StaticResource AmberAccent}" TextWrapping="Wrap"/>
                                    <TextBlock Text="ADB cannot verify a real bootloader unlock operation. Fastboot has not been tested."
                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Inspection.OemUnlock.Value.Evidence}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Explanation}" Foreground="{StaticResource TextMuted}"
                                                           FontSize="10" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <Expander Header="ROOT AND PRIVILEGE FEASIBILITY" IsExpanded="True" Margin="7,0,0,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Root.Value.CurrentShellRoot, StringFormat=Current shell root: {0}}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Inspection.Root.Value.SuAvailability, StringFormat=su availability: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Root.Value.AdbRootFeasibility, StringFormat=ADB root feasibility: {0}}"
                                               Foreground="{StaticResource AmberAccent}"/>
                                    <TextBlock Text="{Binding Inspection.Root.Value.Guidance}"
                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Inspection.Root.Value.Blockers}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource AmberAccent}"
                                                           FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Expander Header="BLUETOOTH" IsExpanded="False" Margin="0,0,7,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Bluetooth.Value.Support, StringFormat=Support: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Bluetooth.Value.IsEnabled, StringFormat=Enabled: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Bluetooth.Value.AdapterState, StringFormat=Adapter: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Bluetooth.Value.ConnectedDevices.Count, StringFormat=Connected devices: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="HDMI, CEC AND AUDIO" IsExpanded="False" Margin="7,0,0,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Hdmi.Value.Support, StringFormat=Support: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Hdmi.Value.CecState, StringFormat=CEC state: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Hdmi.Value.ActiveInput, StringFormat=Active input: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Hdmi.Value.AudioRoute, StringFormat=Audio route: {0}}"
                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Expander Header="DRM AND MEDIA PROTECTION" IsExpanded="False" Margin="0,0,7,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Drm.Value.Availability, StringFormat=Availability: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Drm.Value.Schemes, StringFormat=Schemes: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Drm.Value.SecurityLevels, StringFormat=Security levels: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Drm.Value.Hdcp, StringFormat=HDCP: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="NETWORK DETAILS" IsExpanded="False" Margin="7,0,0,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Network.Value.Gateway, StringFormat=Gateway: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Network.Value.DnsSummary, StringFormat=DNS: {0}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Inspection.Network.Value.LinkSummary}"
                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Expander Header="HARDWARE AND PERFORMANCE" IsExpanded="True" Margin="0,0,7,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Cpu.Value.Architecture, StringFormat=Architecture: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Cpu.Value.LogicalCoreCount, StringFormat=Logical cores: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Memory.Value.TotalBytes, StringFormat=RAM bytes: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Display.Value.CurrentResolution, StringFormat=Display: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Storage.Value.Volumes.Count, StringFormat=Storage volumes: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="SECURITY AND INSTALLATION" IsExpanded="True" Margin="7,0,0,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Inspection.Security.Value.SelinuxState, StringFormat=SELinux: {0}}"/>
                                    <TextBlock Text="{Binding Inspection.Security.Value.VerifiedBootState, StringFormat=Verified Boot: {0}}"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Inspection.Security.Value.AdbRoot, StringFormat=ADB root: {0}}"
